// Tangelo OS overlays, copied to vendor/tangelo by userscripts/before.sh.

runtime_resource_overlay {
    name: "TangeloUpdaterOverlay",
    resource_dirs: ["overlays/TangeloUpdaterOverlay/res"],
    manifest: "overlays/TangeloUpdaterOverlay/AndroidManifest.xml",
    product_specific: true,
}

runtime_resource_overlay {
    name: "TangeloSetupWizardOverlay",
    resource_dirs: ["overlays/TangeloSetupWizardOverlay/res"],
    manifest: "overlays/TangeloSetupWizardOverlay/AndroidManifest.xml",
    product_specific: true,
}
