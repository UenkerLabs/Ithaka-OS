# Settings of the first development build, 2026-10-14; OTA_URL added on 2026-11-03;
# hardened user build instead of userdebug since the build after 2026-11-03.
BRANCH_NAME=lineage-23.2
DEVICE_LIST=asteroids
BUILD_TYPE=user
RELEASE_TYPE=UNOFFICIAL
INCLUDE_PROPRIETARY=false
WITH_GMS=true
# CUSTOM_PACKAGES is set by scripts/build.sh from userscripts/apps.list.
SIGN_BUILDS=true
SIGNATURE_SPOOFING=no
# No Play Integrity patch since the 2026-11-04 build (see SECURITY.md).
APPLY_PI_PATCH=false
PARALLEL_JOBS=8
CCACHE_SIZE=50G
CLEAN_AFTER_BUILD=false
DELETE_OLD_ZIPS=0
DELETE_OLD_LOGS=0
CALL_REPO_SYNC=true
# Updater list: the Updater appends /v2/devices/asteroids/builds (see docs/OTA.md).
OTA_URL=https://raw.githubusercontent.com/UenkerLabs/Ithaka-OS/main/ota
# CALL_REPO_INIT is selected by scripts/build.sh for pinned/tracking mode.
